{
  "manifest_version": 3,
  "name": "FlowState Focus Guardian",
  "version": "1.0.0",
  "description": "Real-time blacklisted site detector & anti-wavering focus guardian for FlowState Productivity Suite",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowState Focus Guardian"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["intervene.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
